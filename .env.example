# Copy to .env.local and set strong, unique values. Never commit .env.local.
# scripts/start-infra.ps1 creates random local credentials if .env.local is absent.
APP_PROFILE=dev
APP_PORT=8088
WEB_PORT=5178
FRONTEND_URL=http://localhost:5178
VITE_API_TARGET=http://127.0.0.1:8088
APP_SSE_MAX_CONNECTIONS=10000
APP_SSE_MAX_CONNECTIONS_PER_USER=8

DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=workbench
DB_USERNAME=workbench
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_ADMIN_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=

WORKBENCH_RUNTIME_ROOT=E:/codex/runtime/creative-workbench
JAVA_HOME=E:/codex/runtime/creative-workbench/java/jdk-21.0.13+9
MAVEN_CMD=E:/develop/apache-maven-3.9.6/apache-maven-3.9.6/bin/mvn.cmd
MYSQL_BASEDIR=E:/develop/mysql-8.0.31-winx64/mysql-8.0.31-winx64
REDIS_SERVER=E:/redis/redis-server.exe
APP_STORAGE_ROOT=E:/codex/runtime/creative-workbench/storage

# Optional model provider and OAuth integrations. Leave disabled until configured.
MUSE_BASE_URL=http://127.0.0.1:18610
MUSE_API_KEY=
# Local loopback key lookup for development; production generation never resolves this key automatically.
MUSE_LOCAL_KEY_ENABLED=false
MUSE_LOCAL_POOL_URL=http://127.0.0.1:18610
# Exact comma-separated trusted CDN hostnames; no wildcards. Blank allows only the provider origin.
MUSE_MEDIA_ALLOWED_HOSTS=
# Blank follows the profile: development on, production off. Does not enable key discovery.
POOL_OVERVIEW_ENABLED=
# Optional platform user IDs allowed to import this host's local Muse credential (loopback required).
# Personal account CRUD is available to every signed-in user when POOL_OVERVIEW_ENABLED=true.
POOL_OVERVIEW_OWNER_IDS=
# Browser worker is loopback-only and requires a random bearer token shared with apps/browser-worker.
BROWSER_WORKER_URL=http://127.0.0.1:8091
BROWSER_WORKER_TOKEN=
# Explicitly enable only on a dedicated machine with a visible desktop login session.
BROWSER_INTERACTIVE_LOGIN_ENABLED=false
# Independent base64-encoded 32-byte key for AES-GCM encrypted pool service credentials.
POOL_CREDENTIAL_MASTER_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Blank uses http://localhost:${APP_PORT}/login/oauth2/code/github in development.
# Production requires an explicit public HTTPS URI matching the GitHub OAuth App registration.
GITHUB_REDIRECT_URI=
# Optional private review identity. Initialize with scripts/init-reviewer.mjs; do not paste a plaintext password here.
REVIEWER_USERNAME=
REVIEWER_PASSWORD_HASH=
REVIEWER_DISPLAY_NAME=作品评审

# Offline narration: auto selects Windows SAPI or Linux eSpeak NG.
# Linux basic Chinese voice is mechanical; no speech models are downloaded automatically.
SCIENCE_TTS_PROVIDER=auto
SCIENCE_ESPEAK_BIN=espeak-ng

# Optional Docker infrastructure profile; set these before docker compose up.
RABBITMQ_USERNAME=workbench
RABBITMQ_PASSWORD=
