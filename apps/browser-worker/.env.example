# Generate a random secret outside the repository; the API process needs the same value.
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_PORT=8091
# Local session files are restricted to E: by default on Windows.
BROWSER_PROFILE_ROOT=E:/codex/runtime/creative-workbench/browser-pool/profiles
# Required before any visible browser window can be opened.
BROWSER_INTERACTIVE_LOGIN_ENABLED=false
BROWSER_MAX_CONTEXTS=2
BROWSER_GENERATION_TIMEOUT_SECONDS=600
BROWSER_MAX_MEDIA_MB=32
# Add only exact HTTPS media hostnames verified by the deployment owner.
BROWSER_MEDIA_ALLOWED_HOSTS=
# Optional full path to Edge or Chrome; when blank, Windows defaults to the installed Edge stable channel.
BROWSER_EXECUTABLE_PATH=
