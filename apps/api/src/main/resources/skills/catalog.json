[
  {
    "id": "image-create",
    "name": "文生图",
    "description": "把创作提示词生成图片素材，支持已有图片参考；生成结果作为画布候选素材，模型可用性取决于服务端配置。",
    "category": "图像创作",
    "capability": "image",
    "status": "available",
    "recipeVersion": "1.0.0",
    "tags": [
      "图片",
      "素材",
      "参考图"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "nodeId",
        "prompt"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "description": "当前用户拥有的已保存项目"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "title": "创作提示词"
        },
        "model": {
          "type": "string",
          "default": "muse-image",
          "maxLength": 120
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 1024
        },
        "referenceAssetIds": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
