      "打斗技巧",
      "动作",
      "分镜",
      "文字生视频"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "nodeId",
        "prompt"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "title": "动作情节",
          "default": "请在这里填写人物、环境和动作情节。生成一个8秒影视动作镜头，先交代人物站位，按试探、攻防、收势推进。保持角色外观、左右位置与运动方向一致，动作有清楚的起势、接触和反应；镜头优先中景或全景，减少突兀切换。不出现血腥细节或伤口特写。"
        },
        "model": {
          "type": "string",
          "default": "muse-video",
          "maxLength": 120
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 1280
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 720
        },
        "duration": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "default": 8
        },
        "referenceAssetIds": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "recipe": {
      "schemaVersion": 1,
      "operation": "generation-job",
      "method": "POST",
      "path": "/api/jobs",
      "kind": "video",
      "authentication": "platform-session",
      "requiredHeaders": [
        "X-Workbench-Request: 1",
        "Idempotency-Key"
      ],
      "resultHandling": "candidate-asset-with-revision-checked-application",
      "providerConfigurationRequired": true,
      "referenceSupportMustBeConfirmed": false,
      "sourceTextRequired": true,
      "promptTemplate": "请将以下情节设计成一个短片中的连贯影视动作镜头。\n\n【用户情节】\n{{text}}\n\n【动作与分镜约束】\n先交代环境、人物身份与站位，在所选时长内按试探、攻防、收势推进，聚焦一组清楚的动作因果，不堆叠过多动作。每个动作有起势、接触或避让、反应，人物肢体自然，空间距离可信。保持角色外观、左右位置、道具与运动方向一致。优先中景或全景展示完整动作，镜头平稳跟随，避免无因跳切、人物瞬移和道具凭空出现。不增加原文没有的角色或改变情节结果。采用影视编排表现，不出现血腥细节、伤口特写或断肢。",
      "automaticExecutionOnInstall": false
    }
  },
