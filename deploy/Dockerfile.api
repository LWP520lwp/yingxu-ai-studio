# syntax=docker/dockerfile:1
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY apps/api/pom.xml ./pom.xml
RUN mvn -B -ntp dependency:go-offline
COPY apps/api/src ./src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre-jammy AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg fontconfig fonts-noto-cjk espeak-ng \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 workbench \
    && useradd --uid 10001 --gid workbench --create-home --shell /usr/sbin/nologin workbench \
    && mkdir -p /app /var/lib/workbench/assets /var/lib/workbench/upload-temp \
    && chown -R 10001:10001 /var/lib/workbench
WORKDIR /app
COPY --from=build /build/target/creative-workbench-api-0.1.0.jar ./app.jar
COPY deploy/api-entrypoint.sh ./entrypoint.sh
COPY deploy/smoke-media.sh ./smoke-media.sh
COPY deploy/fontconfig-workbench.conf /etc/fonts/conf.d/99-workbench.conf
RUN sed -i 's/\r$//' /app/entrypoint.sh /app/smoke-media.sh \
    && chmod 0555 /app/entrypoint.sh /app/smoke-media.sh && fc-cache -f
ENV APP_PROFILE=prod APP_BIND_ADDRESS=0.0.0.0 APP_PORT=8088 \
    APP_STORAGE_ROOT=/var/lib/workbench/assets \
    SPRING_SERVLET_MULTIPART_LOCATION=/var/lib/workbench/upload-temp \
    FFMPEG_BIN=/usr/bin/ffmpeg FFPROBE_BIN=/usr/bin/ffprobe \
    SCIENCE_TTS_PROVIDER=espeak SCIENCE_ESPEAK_BIN=/usr/bin/espeak-ng \
    SESSION_COOKIE_SECURE=true
USER 10001:10001
# This validates the actual runtime binaries and installed Chinese fonts during image build.
RUN /app/smoke-media.sh
EXPOSE 8088
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD curl --fail --silent --max-time 4 http://127.0.0.1:8088/actuator/health > /dev/null || exit 1
ENTRYPOINT ["/app/entrypoint.sh"]


