# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /build
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
COPY LICENSE ./LICENSE
COPY apps/web/package.json ./apps/web/package.json
COPY apps/canvas-engine/package.json ./apps/canvas-engine/package.json
COPY apps/browser-worker/package.json ./apps/browser-worker/package.json
RUN npm ci --no-audit --no-fund
COPY apps/web ./apps/web
COPY apps/canvas-engine ./apps/canvas-engine
# Frontend test sources are typechecked during build and share this public Skill manifest.
COPY apps/api/src/main/resources/skills/catalog.json ./apps/api/src/main/resources/skills/catalog.json
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.28-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

