# Generate .env.production.local, then configure GitHub OAuth or a private reviewer login.
# This example deliberately contains no usable passwords or shared credentials.
APP_DOMAIN=studio.example.com
APP_PUBLIC_ORIGIN=https://studio.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://studio.example.com/login/oauth2/code/github
# Optional private review identity; generate with scripts/init-reviewer.mjs, never use a default password.
REVIEWER_USERNAME=
REVIEWER_PASSWORD_HASH=
REVIEWER_DISPLAY_NAME=作品评审
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
POOL_CREDENTIAL_MASTER_KEY=

# Bound provider calls. This is not a claim of 5000 simultaneous generations.
APP_WORKER_CONCURRENCY=2
APP_SSE_MAX_CONNECTIONS=10000
APP_SSE_MAX_CONNECTIONS_PER_USER=8
# Optional deployment provider; users can also configure personal HTTPS channels after login.
MUSE_BASE_URL=https://api.example.invalid
MUSE_API_KEY=
MUSE_MEDIA_ALLOWED_HOSTS=
